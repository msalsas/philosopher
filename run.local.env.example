# Copia este fichero a `run.local.env` y pon los valores de TU montaje.
# `run.local.env` está en .gitignore (no se sube).

PI_HOST=192.168.1.50          # IP/host de la Pi del toy (OBLIGATORIO)
PI_USER=pi                    # usuario SSH en la Pi (por defecto: tu $USER)
REMOTE_TOY_DIR=philosopher/philosopher-toy   # ruta del toy en la Pi (relativa al home)
