# Copy this file to `run.local.env` and set the values for YOUR setup.
# `run.local.env` is gitignored (not committed).

PI_HOST=192.168.1.50          # IP/host of the toy's Pi (REQUIRED)
PI_USER=pi                    # SSH user on the Pi (default: your $USER)
REMOTE_TOY_DIR=philosopher/philosopher-toy   # toy path on the Pi (relative to home)
