# Philosopher Toy Client Configuration
# This runs on the Banana Pi (512MB) inside the plush toy. Zero ML — thin I/O only.

# Server to connect to (WebSocket). The toy default is ws://localhost:8080
PHILOSOPHER_SERVER_URL=ws://192.168.1.50:8080
PHILOSOPHER_TOY_ID=banana_01

# Camera (capture only; server does the vision). FPS rounds to 0.5 steps, clamped 0.5-5.0
PHILOSOPHER_CAMERA_FPS=0.5
PHILOSOPHER_CAMERA_QUALITY=60

# Mock mode (no physical hardware)
PHILOSOPHER_MOCK=false
