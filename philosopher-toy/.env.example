# Philosopher Toy Client Configuration
# Runs on the Raspberry Pi Zero WH (512MB) inside the plush toy. Zero ML — thin
# I/O only. Audio uses arecord/aplay, the camera uses rpicam-still (both system
# binaries; no OpenCV/PyAudio on the constrained board).

# Server to connect to (WebSocket). Base only; the client appends /ws?toy_id=
PHILOSOPHER_SERVER_URL=ws://192.168.1.50:8080
PHILOSOPHER_TOY_ID=toy_01

# Camera (capture only; the server does the vision). Captured via rpicam-still.
PHILOSOPHER_CAMERA_FPS=0.5              # rounds to 0.5 steps, clamped 0.5-5.0
PHILOSOPHER_CAMERA_QUALITY=60          # JPEG quality 30-90
PHILOSOPHER_CAMERA_WIDTH=640
PHILOSOPHER_CAMERA_HEIGHT=480
PHILOSOPHER_CAMERA_WARMUP_MS=1500      # ms the sensor runs before each shot so AWB/AGC settle (too low -> pink/dark)

# Microphone + energy VAD
PHILOSOPHER_MIC_ALSA_DEVICE=plughw:0,0
PHILOSOPHER_MIC_GAIN=1                  # software gain; >1 can clip (hardware gain is usually already maxed)
PHILOSOPHER_VAD_THRESHOLD=400           # energy above this = speech; tune between the room floor and your voice
PHILOSOPHER_VAD_SILENCE=1.2             # seconds of silence that ends an utterance (lower = snappier, too low cuts you off)
PHILOSOPHER_MIC_DEBUG=0                 # 1 = print energy vs threshold every ~0.5s (tuning)

# Speaker
PHILOSOPHER_SPEAKER_ALSA_DEVICE=plughw:1,0
PHILOSOPHER_SPEAKER_VOLUME=50           # percent; applied with amixer on startup (persists without alsactl). Empty = leave as-is
PHILOSOPHER_SPEAKER_MIXER=PCM           # amixer simple control name for the speaker card

# Servos (BCM pin numbers). Set a pin to 0 to disable that servo — its gestures
# become no-ops, so a partially-wired toy doesn't drive a phantom pin. Each servo
# gets its own 5V + GND pin on the header (no splitter needed for two servos).
PHILOSOPHER_SERVO_HEAD_PIN=12          # head pan (physical pin 32)
PHILOSOPHER_SERVO_LEFT_ARM_PIN=13      # left arm (physical pin 33)
PHILOSOPHER_SERVO_RIGHT_ARM_PIN=0      # right arm (BCM18/pin 12); 0 = not wired

# Mock mode (no physical hardware)
PHILOSOPHER_MOCK=false
