# Philosopher Server Configuration
# Runs on the Raspberry Pi 4 (4GB) and does ALL the AI: STT, vision, TTS, LangGraph.

# LLM — ANY OpenAI-compatible endpoint. Not tied to LM Studio: works with
# Ollama, llama.cpp `server`, vLLM, LocalAI, OpenAI itself, etc. Just point
# BASE_URL at your server. The server only proxies/streams tokens (no local LLM).
PHILOSOPHER_LLM_PROVIDER=local
PHILOSOPHER_LLM_BASE_URL=http://192.168.1.100:1234/v1   # e.g. Ollama :11434/v1, llama.cpp :8080/v1, LM Studio :1234/v1
PHILOSOPHER_LLM_API_KEY=not-needed      # any placeholder for local servers; your real key for OpenAI
PHILOSOPHER_LLM_MODEL=llama-3.1-8b      # the model id your server exposes (GET /v1/models)
PHILOSOPHER_LLM_MAX_TOKENS=4096
PHILOSOPHER_LLM_TEMPERATURE=0.7         # validated to [0.0, 2.0]
PHILOSOPHER_LLM_TIMEOUT=30

# Personality (language folder + personality file)
PHILOSOPHER_PERSONALITY=filosofo
PHILOSOPHER_NAME=Philosopher
PHILOSOPHER_LANGUAGE=es

# Wake-word gate (opt-in). When true, the toy stays quiet until it hears an
# activation phrase and only then converses; a deactivation phrase or
# PHILOSOPHER_SLEEP_TIMEOUT seconds of silence send it back to sleep. The
# phrases live in the personality YAML (`wake:` section), so they're localized.
PHILOSOPHER_WAKE_ENABLED=false
PHILOSOPHER_SLEEP_TIMEOUT=1800          # seconds of inactivity -> back to sleep (30 min)

# Memory
PHILOSOPHER_MEMORY_DB_PATH=./data/philosopher_memory.db

# STT (server-side, faster-whisper)
PHILOSOPHER_STT_MODEL=tiny              # tiny | base | small
PHILOSOPHER_STT_DEVICE=cpu
PHILOSOPHER_STT_COMPUTE_TYPE=int8       # int8 (CPU) | float16 (CUDA GPU)
PHILOSOPHER_STT_CPU_THREADS=0           # 0 = all cores; lower (e.g. 2) if a marginal PSU under-volts under load
PHILOSOPHER_STT_CONFIDENCE_THRESHOLD=-0.5   # avg_logprob floor; below it -> "not understood"

# Vision / camera (emotion = FER+ ONNX; identity = face_recognition)
PHILOSOPHER_CAMERA_FPS=0.5              # rounds to 0.5 steps, clamped 0.5-5.0
PHILOSOPHER_CAMERA_QUALITY=60           # JPEG quality 30-90
# Empty = auto-download FER+ model to ./data/fer_models/ on first use.
# Pin it (or pre-download via scripts/download_models.py) to avoid network at startup.
PHILOSOPHER_CAMERA_EMOTION_MODEL_PATH=
# Frame-processing gates (cheap checks before the expensive dlib path) + dedup.
PHILOSOPHER_CAMERA_DETECT_WIDTH=480     # downscale width for detection; 0 disables
PHILOSOPHER_CAMERA_PRESENCE_GATE=true   # skip dlib when a cheap Haar check sees no face
PHILOSOPHER_CAMERA_SKIP_SIMILAR=true    # reuse last result on near-identical frames
PHILOSOPHER_CAMERA_SKIP_THRESHOLD=2.0   # mean grayscale delta (0-255) that counts as "same"
PHILOSOPHER_CAMERA_MERGE_BAND=0.68      # name-collision biometric dedup; must be >= tolerance. TUNE ON HARDWARE.

# TTS — provider is selectable, all env-driven:
#   piper  (default): local/offline, `piper` binary on PATH. Params: LENGTH_SCALE/NOISE_SCALE/NOISE_W.
#   kokoro: local/offline neural (natural). Needs extra `.[tts-kokoro]` + system espeak-ng +
#           the model (scripts/download_models.py). Params: VOICE (em_santa/em_alex/...), LANG, SPEED.
#   edge:   Microsoft ONLINE neural voices (needs extra `.[tts-edge]` + system ffmpeg + internet).
#           Params: VOICE (es-ES-AlvaroNeural), RATE, PITCH_HZ.
PHILOSOPHER_TTS_ENABLED=true
PHILOSOPHER_TTS_PROVIDER=piper          # piper | kokoro | edge
PHILOSOPHER_TTS_VOICE=es_ES-carlfm-x_low
PHILOSOPHER_TTS_PITCH=1.0               # post pitch/formant shift on the WAV; <1 = deeper (all providers)
# piper expression:
PHILOSOPHER_TTS_LENGTH_SCALE=1.0        # <1 = faster speech
PHILOSOPHER_TTS_NOISE_SCALE=0.667       # higher = livelier pitch
PHILOSOPHER_TTS_NOISE_W=0.8             # higher = livelier rhythm
# kokoro:
PHILOSOPHER_TTS_LANG=es
PHILOSOPHER_TTS_SPEED=1.0
# edge:
PHILOSOPHER_TTS_RATE=+0%
PHILOSOPHER_TTS_PITCH_HZ=+0Hz
# Empty = auto-download to ./data/piper_models/. Keep this comment on its OWN
# line: load_dotenv parses an inline comment after an EMPTY value as the value.
PHILOSOPHER_TTS_MODEL_PATH=

# API Server (WebSocket /ws + HTTP)
PHILOSOPHER_API_ENABLED=true
PHILOSOPHER_API_HOST=0.0.0.0
PHILOSOPHER_API_PORT=8080

# Logging
PHILOSOPHER_LOG_LEVEL=INFO
PHILOSOPHER_LOG_FORMAT=rich

# Mock mode: stub STT/vision/TTS so the server runs with no models/hardware
MOCK_MODE=false
